
# Recursive function to find the largest item in a list
def recursive_max(lst):
    if len(lst) == 1:
        return lst[0]
    max_of_rest = recursive_max(lst[1:])
    return lst[0] if lst[0] > max_of_rest else max_of_rest

# Main program for testing
if __name__ == "__main__":
    # Test the recursive max function
    test_list = [3, 1, 4, 1, 5, 9, 2, 6, 5]  # Example list
    largest_item = recursive_max(test_list)
    print(f"The largest item in the list {test_list} is: {largest_item}")
