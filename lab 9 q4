Function to extract unique words from a file
def extract_unique_words(file_path):
    try:
        with open(file_path, 'r') as file:
            unique_words = set()
            for line in file:
                words = line.split()
                unique_words.update(word.strip(".,!?""'()[]") for word in words)
        return unique_words
    except FileNotFoundError:
        print(f"Error: The file '{file_path}' was not found.")
        return set()

