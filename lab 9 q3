

#  for encoding letters
cipher = {
    'A': '%', 'a': '9', 'B': '@', 'b': '#', 'C': '&', 'c': '1', 'D': '*', 'd': '2',
    'E': '!', 'e': '3', 'F': '^', 'f': '4', 'G': '(', 'g': '5', 'H': ')', 'h': '6',
    'I': '-', 'i': '7', 'J': '+', 'j': '8', 'K': '=', 'k': '0', 'L': '{', 'l': '}',
    'M': '[', 'm': ']', 'N': '|', 'n': '<', 'O': '>', 'o': '?', 'P': '/', 'p': '~',
    'Q': '$', 'q': '`', 'R': ';', 'r': ':', 'S': ',', 's': '.', 'T': '_', 't': '"',
    'U': '\\', 'u': 'x', 'V': 'y', 'v': 'z', 'W': 'A', 'w': 'B', 'X': 'C', 'x': 'D',
    'Y': 'E', 'y': 'F', 'Z': 'G', 'z': 'H', ' ': '*', '\n': '\n'
}

# Reverse the dictionary for decryption
decipher = {value: key for key, value in cipher.items()}

# Function to encrypt a file
def encrypt_file(input_file, output_file):
    try:
        with open(input_file, 'r') as infile, open(output_file, 'w') as outfile:
            for line in infile:
                encrypted_line = ''.join(cipher.get(char, char) for char in line)
                outfile.write(encrypted_line)
        print(f"File '{input_file}' has been encrypted to '{output_file}'.")
    except FileNotFoundError:
        print(f"Error: The file '{input_file}' was not found.")

# Function to decrypt a file
def decrypt_file(input_file):
    try:
        with open(input_file, 'r') as infile:
            for line in infile:
                decrypted_line = ''.join(decipher.get(char, char) for char in line)
                print(decrypted_line)  # Removed 'end' argument to avoid errors
    except FileNotFoundError:
        print(f"Error: The file '{input_file}' was not found.")

